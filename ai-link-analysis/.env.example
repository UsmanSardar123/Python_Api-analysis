# =============================================================================
# AI-Powered Website Link Analysis API - Environment Configuration
# Copy this file to .env and provide your actual API key(s).
# NEVER commit your actual .env file to version control.
# =============================================================================

# Primary LLM Provider: "gemini" or "openai" (default: "gemini")
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Recommended Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Fallback or Primary if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional Fallback Provider Enablement (true/false)
ENABLE_LLM_FALLBACK=true

# Website Extraction Security & Networking Limits
HTTP_TIMEOUT_SECONDS=15.0
MAX_RESPONSE_BYTES=2097152
MAX_REDIRECTS=5
USER_AGENT=AILinkAnalysisBot/1.0 (+https://github.com/example/ai-link-analysis)

# Server Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

